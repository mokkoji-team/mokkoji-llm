# notion.so/my-integrations 에서 발급한 internal integration secret
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 인덱싱 시작점이 되는 노션 루트 페이지 ID (기본값: 팀 - 모꼬지)
NOTION_ROOT_PAGE_ID=1837455c17d080358725cd5e57fb92db

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mokkoji_docs

# 디코더(LLM). 프로바이더를 바꾸면 모델 교체가 끝난다.
#   ollama    LLM_MODEL=exaone3.5:2.4b, qwen3:4b, gemma3:1b ...
#   anthropic LLM_MODEL=claude-opus-5   (pip install langchain-anthropic, ANTHROPIC_API_KEY 필요)
#   openai    LLM_MODEL=gpt-4.1-mini    (pip install langchain-openai, OPENAI_API_KEY 필요)
LLM_PROVIDER=ollama
LLM_MODEL=exaone3.5:2.4b
OLLAMA_HOST=http://localhost:11434

# 인코더(임베딩). bge-m3만 sparse를 함께 내놓아 하이브리드 검색이 된다.
# 나머지 프로바이더를 고르면 dense 단독 검색으로 자동 전환된다.
# 인코더를 바꾸면 벡터 차원이 달라지므로 `python -m scripts.index --recreate`로 다시 인덱싱할 것.
#   bge-m3      EMBEDDING_MODEL=BAAI/bge-m3
#   huggingface EMBEDDING_MODEL=intfloat/multilingual-e5-large (pip install langchain-huggingface)
#   openai      EMBEDDING_MODEL=text-embedding-3-small        (pip install langchain-openai)
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3

# 디스코드 개발자 포털에서 발급한 봇 토큰
DISCORD_TOKEN=
# 슬래시 커맨드를 즉시 등록할 길드(서버) ID. 비우면 글로벌 등록(반영에 최대 1시간)
DISCORD_GUILD_ID=
