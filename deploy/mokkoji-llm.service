[Unit]
Description=Mokkoji LLM FastAPI service
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mokkoji-llm
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/mokkoji-llm/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
